{
  "name": "ems-system",
  "private": true,
  "version": "1.13.3",
  "type": "module",
  "description": "救護科業務管理系統 - 業務 CRUD、期限提醒、進度管理、屬性分類、跨裝置雲端同步",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:rules": "node scripts/run-rules-test.mjs",
    "tool:ems": "node tools/ems-report/index.mjs",
    "tool:ems:test": "node --test tools/ems-report/*.test.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^11.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "exceljs": "^4.4.0",
    "firebase-tools": "^15.24.0",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.62.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
