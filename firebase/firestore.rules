rules_version = '2';

// Firestore 安全規則：權限的「最終防線」。
// 即使前端被繞過，下列規則仍會在資料庫層阻擋未授權的讀寫。
//
// 權限模型（v1.8 起，多人共用同一批資料）：
// - 管理員（email 白名單）：可做所有事，包含核准帳號與所有「刪除」動作。
// - 一般使用者（已核准）：可讀取、新增、編輯業務/屬性/待辦公版，
//   但**不可刪除**業務、屬性、待辦公版（v1.8.1 起三者皆鎖）。
// - **解鎖專用（role == 'unlocker'，v1.17 起）**：權限最低。只能建立解鎖工單、
//   讀取**自己送出的**工單；業務/屬性/公版/假日一律讀不到也寫不了。
//   給各分隊申請解鎖用，不需要也不應該看到科內業務。
// - 待審核 / 未通過的帳號：完全不能存取業務資料，只能讀寫自己的 users 文件。
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 管理員以「登入 token 內的 email」認定，而非 users 文件，
    // 避免使用者自行竄改文件提權。
    // ⚠️ 須與 src/config/constants.ts 的 ADMIN_EMAILS 一致。
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'seansu1220@gmail.com';
    }

    // 讀取自己的 users 文件（管理員不需查文件，見 isApproved）。
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 已核准的正式帳號（管理員一律視為已核准，避免文件缺欄位時把自己鎖在外面）。
    function isApproved() {
      return isAdmin() || (isSignedIn() && myUser().status == 'approved');
    }

    // 可使用**業務管理系統**的人＝已核准，且不是「解鎖專用」帳號。
    // 管理員一律放行：管理員身分來自 email 白名單，即使文件的 role 被改壞
    // 也不能把唯一改得回來的人鎖在外面。
    // ⚠️ 須與 src/lib/permissions.ts 的 canUseTaskSystem() 一致。
    function isStaff() {
      return isAdmin() || (isApproved() && myUser().role != 'unlocker');
    }

    // 建立資料時記錄建立者，強制等於自己。
    function isCreatingOwn() {
      return isStaff() && request.resource.data.ownerUid == request.auth.uid;
    }

    // ── 使用者帳號 ──
    match /users/{uid} {
      // 讀自己的文件；管理員可讀任何人（審核用）。
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // 列出全部帳號僅限管理員（使用者管理頁）。
      allow list: if isAdmin();

      // 註冊時只能建立自己的文件，且 role/status 必須是系統認定的值：
      // 管理員 email → admin/approved；其他人 → member/pending（須經核准）。
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == (isAdmin() ? 'admin' : 'member')
        && request.resource.data.status == (isAdmin() ? 'approved' : 'pending');

      // 管理員可調整任何人的角色/狀態；
      // 本人只能改自己的其他欄位（role 與 status 不可自行變更＝不可自我核准）。
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    // ── 屬性（分類）：業務人員共用；只有管理員可刪除 ──
    match /categories/{categoryId} {
      allow read: if isStaff();
      allow create: if isCreatingOwn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── 業務：業務人員共用；只有管理員可刪除 ──
    match /tasks/{taskId} {
      allow read: if isStaff();
      allow create: if isCreatingOwn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── 待辦公版（範本）：業務人員共用；只有管理員可刪除 ──
    match /checklistTemplates/{templateId} {
      allow read: if isStaff();
      allow create: if isCreatingOwn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── 國定假日（辦公日曆表）：業務人員可讀（首頁天數計算要用），
    //    但只有管理員能匯入/刪除——這份資料會改變所有人看到的剩餘天數。
    match /holidays/{year} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── 解鎖工單（v1.17 起）──
    //
    // 這條流程是：網頁提出申請 → 救護科電腦上的本機工具實際解鎖 → 結果回寫。
    // 因此「誰能建立」與「誰能回寫結果」是兩種人：
    //   - 建立：已核准的任何帳號（含解鎖專用），但只能掛自己的名字
    //   - 回寫結果：只有業務人員（實際去跑解鎖的是他們的電腦）
    //
    // 讀取分兩種：業務人員看得到全部（要去跑）；解鎖專用帳號只看得到自己送的。
    //
    // ⚠️ 這一條同時管住 list：Firestore 會要求查詢本身「證明得出結果都符合規則」，
    // 因此解鎖專用帳號**必須**帶上 where('requestedBy','==',uid) 才查得動，
    // 沒帶條件的整包查詢會被直接拒絕（見 unlockRequestService.subscribeUnlockRequests）。
    match /unlockRequests/{requestId} {
      allow read: if isStaff()
        || (isApproved() && resource.data.requestedBy == request.auth.uid);

      // 新工單一律從 pending 開始，且申請人必須是自己——
      // 不能替別人送，也不能直接送一張「已解鎖」的假工單。
      allow create: if isApproved()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.temsis is string
        && request.resource.data.temsis.size() > 0;

      // 只有業務人員能回寫結果，且不可竄改申請內容（TEMSIS、事由、申請人、申請時間）。
      allow update: if isStaff()
        && request.resource.data.temsis == resource.data.temsis
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.requestedAt == resource.data.requestedAt;

      allow delete: if isAdmin();
    }

    // ── 測試用傷票（v1.21 起）──
    //
    // 號碼 H00T000 ~ H99T999（流水號 0 ~ 99999）全系統接續發放：
    //   - triageTagCounter/main：{ nextSerial } 下一個要發的流水號
    //   - triageTagIssues/{起始流水號}：一次領取一筆 { startSerial, count, requestedBy, ... }
    // 兩份文件必須在**同一個 transaction** 裡一起寫，規則用 getAfter 互相核對：
    //   - 領取紀錄的起始號＝計數器原本的下一號（不能自己挑號碼、不能重複領）
    //   - 計數器往後推的張數＝領取紀錄的張數（不能偷跳號，也不能只推計數器不留紀錄）
    // 三種角色（含解鎖專用）只要已核准都能領。
    // ⚠️ 單次上限 100 須與 src/config/triageTag.ts 的 TRIAGE_TAG_MAX_PER_REQUEST 一致。
    function triageCounterPath() {
      return /databases/$(database)/documents/triageTagCounter/main;
    }

    function triageIssuePath(startSerial) {
      return /databases/$(database)/documents/triageTagIssues/$(string(startSerial));
    }

    // 這次寫入之前，計數器上的下一號（還沒有計數器＝從 0 開始）。
    function triageNextBefore() {
      return exists(triageCounterPath()) ? get(triageCounterPath()).data.nextSerial : 0;
    }

    match /triageTagCounter/{counterId} {
      allow read: if isApproved();

      // 只准往後推，而且同一筆寫入裡必須新建一張對得上的領取紀錄。
      allow create, update: if isApproved()
        && counterId == 'main'
        && request.resource.data.nextSerial is int
        && !exists(triageIssuePath(triageNextBefore()))
        && existsAfter(triageIssuePath(triageNextBefore()))
        && request.resource.data.nextSerial
          == triageNextBefore() + getAfter(triageIssuePath(triageNextBefore())).data.count;

      // 刪掉計數器等於號碼從頭再發一次，一律禁止。
      allow delete: if false;
    }

    match /triageTagIssues/{issueId} {
      // 業務人員看得到全部；其他已核准帳號（解鎖專用）只看得到自己領的。
      allow read: if isStaff()
        || (isApproved() && resource.data.requestedBy == request.auth.uid);

      allow create: if isApproved()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.startSerial is int
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 100
        && request.resource.data.startSerial == triageNextBefore()
        && issueId == string(request.resource.data.startSerial)
        && request.resource.data.startSerial + request.resource.data.count <= 100000
        && getAfter(triageCounterPath()).data.nextSerial
          == request.resource.data.startSerial + request.resource.data.count;

      // 領取紀錄是號碼發放的帳本，發出去就不改；誤領的由管理員刪除紀錄（號碼不回收）。
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
