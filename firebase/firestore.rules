rules_version = '2';

// Firestore 安全規則：權限的「最終防線」。
// 即使前端被繞過，下列規則仍會在資料庫層阻擋未授權的讀寫。
//
// 權限模型（v1.8 起，多人共用同一批資料）：
// - 管理員（email 白名單）：可做所有事，包含核准帳號與所有「刪除」動作。
// - 一般使用者（已核准）：可讀取、新增、編輯業務/屬性/待辦公版，
//   但**不可刪除**業務、屬性、待辦公版（v1.8.1 起三者皆鎖）。
// - **解鎖專用（role == 'unlocker'，v1.17 起）**：權限最低。只能建立解鎖工單、
//   讀取**自己送出的**工單；業務/屬性/公版/假日一律讀不到也寫不了。
//   給各分隊申請解鎖用，不需要也不應該看到科內業務。
// - 待審核 / 未通過的帳號：完全不能存取業務資料，只能讀寫自己的 users 文件。
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 管理員以「登入 token 內的 email」認定，而非 users 文件，
    // 避免使用者自行竄改文件提權。
    // ⚠️ 須與 src/config/constants.ts 的 ADMIN_EMAILS 一致。
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'seansu1220@gmail.com';
    }

    // 讀取自己的 users 文件（管理員不需查文件，見 isApproved）。
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 已核准的正式帳號（管理員一律視為已核准，避免文件缺欄位時把自己鎖在外面）。
    function isApproved() {
      return isAdmin() || (isSignedIn() && myUser().status == 'approved');
    }

    // 可使用**業務管理系統**的人＝已核准，且不是「解鎖專用」帳號。
    // 管理員一律放行：管理員身分來自 email 白名單，即使文件的 role 被改壞
    // 也不能把唯一改得回來的人鎖在外面。
    // ⚠️ 須與 src/lib/permissions.ts 的 canUseTaskSystem() 一致。
    function isStaff() {
      return isAdmin() || (isApproved() && myUser().role != 'unlocker');
    }

    // 建立資料時記錄建立者，強制等於自己。
    function isCreatingOwn() {
      return isStaff() && request.resource.data.ownerUid == request.auth.uid;
    }

    // ── 使用者帳號 ──
    match /users/{uid} {
      // 讀自己的文件；管理員可讀任何人（審核用）。
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // 列出全部帳號僅限管理員（使用者管理頁）。
      allow list: if isAdmin();

      // 註冊時只能建立自己的文件，且 role/status 必須是系統認定的值：
      // 管理員 email → admin/approved；其他人 → member/pending（須經核准）。
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == (isAdmin() ? 'admin' : 'member')
        && request.resource.data.status == (isAdmin() ? 'approved' : 'pending');

      // 管理員可調整任何人的角色/狀態；
      // 本人只能改自己的其他欄位（role 與 status 不可自行變更＝不可自我核准）。
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    // ── 屬性（分類）：業務人員共用；只有管理員可刪除 ──
    match /categories/{categoryId} {
      allow read: if isStaff();
      allow create: if isCreatingOwn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── 業務：業務人員共用；只有管理員可刪除 ──
    match /tasks/{taskId} {
      allow read: if isStaff();
      allow create: if isCreatingOwn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── 待辦公版（範本）：業務人員共用；只有管理員可刪除 ──
    match /checklistTemplates/{templateId} {
      allow read: if isStaff();
      allow create: if isCreatingOwn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── 國定假日（辦公日曆表）：業務人員可讀（首頁天數計算要用），
    //    但只有管理員能匯入/刪除——這份資料會改變所有人看到的剩餘天數。
    match /holidays/{year} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── 解鎖工單（v1.17 起）──
    //
    // 這條流程是：網頁提出申請 → 救護科電腦上的本機工具實際解鎖 → 結果回寫。
    // 因此「誰能建立」與「誰能回寫結果」是兩種人：
    //   - 建立：已核准的任何帳號（含解鎖專用），但只能掛自己的名字
    //   - 回寫結果：只有業務人員（實際去跑解鎖的是他們的電腦）
    //
    // 讀取分兩種：業務人員看得到全部（要去跑）；解鎖專用帳號只看得到自己送的。
    //
    // ⚠️ 這一條同時管住 list：Firestore 會要求查詢本身「證明得出結果都符合規則」，
    // 因此解鎖專用帳號**必須**帶上 where('requestedBy','==',uid) 才查得動，
    // 沒帶條件的整包查詢會被直接拒絕（見 unlockRequestService.subscribeUnlockRequests）。
    match /unlockRequests/{requestId} {
      allow read: if isStaff()
        || (isApproved() && resource.data.requestedBy == request.auth.uid);

      // 新工單一律從 pending 開始，且申請人必須是自己——
      // 不能替別人送，也不能直接送一張「已解鎖」的假工單。
      allow create: if isApproved()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.temsis is string
        && request.resource.data.temsis.size() > 0;

      // 只有業務人員能回寫結果，且不可竄改申請內容（TEMSIS、事由、申請人、申請時間）。
      allow update: if isStaff()
        && request.resource.data.temsis == resource.data.temsis
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.requestedAt == resource.data.requestedAt;

      allow delete: if isAdmin();
    }

    // ── 測試用傷票（v1.21 起）──
    //
    // 號碼 H00T000 ~ H99T999（流水號 0 ~ 99999）全系統接續發放：
    //   - triageTagCounter/main：{ nextSerial } 下一個要發的流水號
    //   - triageTagIssues/{起始流水號}：一次領取一筆 { startSerial, count, unit, weekIndex, requestedBy, ... }
    //   - triageTagUnitWeeks/{週序}_{單位}：某單位這一週已領幾張 { unit, weekIndex, used }（v1.22 起）
    // 三份文件必須在**同一個 transaction** 裡一起寫，規則用 getAfter 互相核對：
    //   - 領取紀錄的起始號＝計數器原本的下一號（不能自己挑號碼、不能重複領）
    //   - 計數器往後推的張數＝領取紀錄的張數（不能偷跳號，也不能只推計數器不留紀錄）
    //   - 單位本週用量加上的張數＝領取紀錄的張數，且不超過每週上限 20 張
    //   - 單位必須是月報表上的分隊，週序必須是伺服器時間的這一週
    // 三種角色（含解鎖專用）只要已核准都能領。
    // ⚠️ 單次上限 100 須與 src/config/triageTag.ts 的 TRIAGE_TAG_MAX_PER_REQUEST 一致；
    //    每週 20 張須與 TRIAGE_TAG_UNIT_WEEKLY_LIMIT 一致；單位名單須與 TRIAGE_TAG_BRIGADES 一致。
    function triageCounterPath() {
      return /databases/$(database)/documents/triageTagCounter/main;
    }

    function triageIssuePath(startSerial) {
      return /databases/$(database)/documents/triageTagIssues/$(string(startSerial));
    }

    function triageUnitWeekPath(weekIndex, unit) {
      return /databases/$(database)/documents/triageTagUnitWeeks/$(string(weekIndex) + '_' + unit);
    }

    // 伺服器時間的「第幾週」（台灣時間 UTC+8、週一起算）。
    // ⚠️ 須與 src/lib/triageTagNumber.ts 的 triageTagWeekIndex() 算法一致：
    //    1970-01-01 是星期四，本地日序 + 3 再除以 7，剛好在每個週一跳號。
    function triageWeekIndex() {
      // math.floor 回傳的是小數（2960.0），組文件 ID 前一定要轉成整數，否則會變成「2960.0_大湳分隊」。
      let localDay = int(math.floor((request.time.toMillis() + 28800000) / 86400000));
      return int(math.floor((localDay + 3) / 7));
    }

    // 單位只限月報表上的分隊（第一～第四大隊，共 41 個）。
    // ⚠️ 須與 src/config/triageTag.ts 的 TRIAGE_TAG_BRIGADES、tools/ems-report/config.mjs 的 BRIGADES 一致。
    // 另外「救護科」只有管理員能用，且不受每週上限（v1.24，使用者 2026-09-21 指定；
    // ⚠️ 須與 src/config/triageTag.ts 的 TRIAGE_TAG_ADMIN_UNIT 一致）。
    function triageUnitValid(unit) {
      return unit is string && ((unit == '救護科' && isAdmin()) || unit in [
        '桃園分隊', '中路分隊', '大林分隊', '三民分隊', '大有分隊', '埔子分隊', '八德分隊', '大湳分隊', '茄苳分隊', '龜山分隊', '坪頂分隊', '迴龍分隊',
        '中壢分隊', '興國分隊', '華勛分隊', '內壢分隊', '龍岡分隊', '青埔分隊', '楊梅分隊', '幼獅分隊', '埔心分隊', '富岡分隊', '新屋分隊', '永安分隊',
        '蘆竹分隊', '山腳分隊', '大竹分隊', '大園分隊', '竹圍分隊', '觀音分隊', '新坡分隊', '草漯分隊',
        '圳頂分隊', '大溪分隊', '平鎮分隊', '復旦分隊', '山峰分隊', '龍潭分隊', '高平分隊', '復興分隊', '巴陵分隊'
      ]);
    }

    // 這一筆寫入裡「新建」了起始號為 startSerial 的領取紀錄（原本不存在、寫完存在）。
    function triageIssueCreatedWith(startSerial) {
      return !exists(triageIssuePath(startSerial)) && existsAfter(triageIssuePath(startSerial));
    }

    // 這次寫入之前，計數器上的下一號（還沒有計數器＝從 0 開始）。
    function triageNextBefore() {
      return exists(triageCounterPath()) ? get(triageCounterPath()).data.nextSerial : 0;
    }

    match /triageTagCounter/{counterId} {
      allow read: if isApproved();

      // 只准往後推，而且同一筆寫入裡必須新建一張對得上的領取紀錄。
      // 計數器自己的舊值直接用 resource（少一次文件讀取；規則每次寫入能讀的文件數有上限）。
      allow create, update: if isApproved()
        && counterId == 'main'
        && request.resource.data.nextSerial is int
        && triageIssueCreatedWith(resource == null ? 0 : resource.data.nextSerial)
        && request.resource.data.nextSerial
          == (resource == null ? 0 : resource.data.nextSerial)
            + getAfter(triageIssuePath(resource == null ? 0 : resource.data.nextSerial)).data.count;

      // 刪掉計數器等於號碼從頭再發一次，一律禁止。
      allow delete: if false;
    }

    match /triageTagIssues/{issueId} {
      // 業務人員看得到全部；其他已核准帳號（解鎖專用）只看得到自己領的。
      allow read: if isStaff()
        || (isApproved() && resource.data.requestedBy == request.auth.uid);

      allow create: if isApproved()
        && request.resource.data.requestedBy == request.auth.uid
        && triageUnitValid(request.resource.data.unit)
        && request.resource.data.weekIndex == triageWeekIndex()
        // 單位本週用量必須在同一筆寫入裡被「這一張」紀錄更新過（加量的核對在 triageTagUnitWeeks 那一條）
        && getAfter(triageUnitWeekPath(triageWeekIndex(), request.resource.data.unit)).data.lastStartSerial
          == request.resource.data.startSerial
        && request.resource.data.startSerial is int
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 100
        && request.resource.data.startSerial == triageNextBefore()
        && issueId == string(request.resource.data.startSerial)
        && request.resource.data.startSerial + request.resource.data.count <= 100000
        && getAfter(triageCounterPath()).data.nextSerial
          == request.resource.data.startSerial + request.resource.data.count;

      // 領取紀錄是號碼發放的帳本（單位週用量的核對寫在 triageTagUnitWeeks 那一條），發出去就不改；誤領的由管理員刪除紀錄（號碼不回收）。
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 單位週用量：只能隨著一張新的領取紀錄一起往上加，而且加的量＝那張紀錄的張數，
    // 加完不超過每週 20 張。文件 ID 必須是「這一週的週序_單位」，不能改寫別週或別單位。
    // lastStartSerial＝這次一起建立的領取紀錄起始號：領取紀錄那一條靠它確認用量真的有被加上去
    // （只寫紀錄不動用量＝繞過上限）。刻意不在這裡重讀計數器——
    // 規則每筆寫入能讀的文件數有上限（批次寫入 20 次），三份文件互相核對很容易超過。
    match /triageTagUnitWeeks/{usageId} {
      allow read: if isApproved();

      allow create, update: if isApproved()
        && triageUnitValid(request.resource.data.unit)
        && request.resource.data.weekIndex == triageWeekIndex()
        && usageId == string(triageWeekIndex()) + '_' + request.resource.data.unit
        && request.resource.data.used is int
        && (request.resource.data.used <= 20 || request.resource.data.unit == '救護科')
        && request.resource.data.lastStartSerial is int
        && triageIssueCreatedWith(request.resource.data.lastStartSerial)
        && getAfter(triageIssuePath(request.resource.data.lastStartSerial)).data.unit
          == request.resource.data.unit
        && request.resource.data.used
          == (resource == null ? 0 : resource.data.used)
            + getAfter(triageIssuePath(request.resource.data.lastStartSerial)).data.count;

      allow delete: if isAdmin();
    }
  }
}
