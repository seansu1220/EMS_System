# 依賴
node_modules/

# 建置輸出
dist/
dist-ssr/
*.local

# 環境變數與密鑰（CLAUDE.md 規範）
.env
.env.*
!.env.example
*.pkl

# Firebase 服務帳號金鑰（絕不可進版控）
serviceAccountKey.json
firebase-service-account*.json
.firebase/

# 小工具產出：含系統匯出的個案明細與彙總報表，絕不進版控
tools/**/out/

# 小工具保存的登入狀態（cookie，等同登入憑證），絕不進版控
tools/**/.auth/

# 捷徑資料夾裡的**實際名單與匯出檔**含個資，只有空白範本可以進版控
捷徑/大量傷患權限/各分隊開通名單/
捷徑/二級以上因交通事故救護案件/匯出格式.xlsx

# 可攜版打包產物（內含整份 Node.js 與套件，由 scripts/make-portable.ps1 產生）
可攜版/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 編輯器與系統
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log

# Excel 開啟中產生的暫存鎖定檔
~$*

# 暫時性的臨時腳本（開頭底線＝隨手寫來查東西的，不進版控）
_*.mjs
tools/ems-report/_*.mjs
